# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://melatea_admin:melatea_secret_password_2026@localhost:5432/melatea_partner_db?schema=public"

# Maps Provider (OpenFreeMap - Free & Commercial Friendly)
MAP_PROVIDER=openfreemap
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
DEFAULT_MAP_LAT=-7.5755
DEFAULT_MAP_LNG=110.8243
DEFAULT_MAP_ZOOM=11
DEFAULT_RADIUS_KM=3.0

# Geoapify Geocoding API
GEOAPIFY_API_KEY=
GEOCODING_PROVIDER=geoapify
GEOCODING_ENABLED=true
GEOAPIFY_DAILY_CREDIT_BUDGET=2500
